diff --git a/siano-ts.c b/siano-ts.c
--- a/siano-ts.c
+++ b/siano-ts.c
@@ -88,5 +88,10 @@ struct ts_queue {
     size_t tail;
     size_t count;
     uint64_t drops;
+    uint64_t accepted_bytes;
+    uint64_t dequeued_bytes;
+    uint64_t dropped_bytes;
+    uint64_t truncated_bytes;
+    bool counters_saturated;
     bool closed;
 };
@@ -112,3 +112,5 @@ struct siano_device {
     struct siano_stream_state state;
     int active_transfers;
+    uint64_t transfer_error_events;
+    bool counters_saturated;
     struct libusb_transfer *transfers[MAX_URBS];
@@ -484,4 +484,15 @@ static void cond_deadline_from_now(struct timespec *deadline, unsigned extra_ms)
     }
 }
 
+static void counter_add(uint64_t *counter, size_t amount, bool *saturated)
+{
+    const uint64_t value = (uint64_t)amount;
+    if (*counter > UINT64_MAX - value) {
+        *counter = UINT64_MAX;
+        *saturated = true;
+    } else {
+        *counter += value;
+    }
+}
+
 static int ts_queue_init(struct ts_queue *queue)
@@ -546,12 +564,18 @@ static void ts_enqueue(struct ts_queue *queue, const uint8_t *data, size_t length)
 {
+    size_t copied_length = length;
+
     pthread_mutex_lock(&queue->mutex);
     if (queue->closed || queue->count == TS_QUEUE_SLOTS) {
         queue->drops++;
+        counter_add(&queue->dropped_bytes, length, &queue->counters_saturated);
         pthread_mutex_unlock(&queue->mutex);
         return;
     }
     if (length > sizeof(queue->chunks[queue->tail].data))
-        length = sizeof(queue->chunks[queue->tail].data);
-    memcpy(queue->chunks[queue->tail].data, data, length);
-    queue->chunks[queue->tail].length = length;
+        copied_length = sizeof(queue->chunks[queue->tail].data);
+    counter_add(&queue->truncated_bytes, length - copied_length,
+                &queue->counters_saturated);
+    memcpy(queue->chunks[queue->tail].data, data, copied_length);
+    queue->chunks[queue->tail].length = copied_length;
+    counter_add(&queue->accepted_bytes, copied_length, &queue->counters_saturated);
     queue->tail = (queue->tail + 1) % TS_QUEUE_SLOTS;
@@ -580,3 +605,4 @@ static int ts_pop(struct ts_queue *queue, uint8_t *data, size_t *length)
         queue->head = (queue->head + 1) % TS_QUEUE_SLOTS;
         queue->count--;
+        counter_add(&queue->dequeued_bytes, *length, &queue->counters_saturated);
         rc = 0;
@@ -662,4 +688,7 @@ static void fail_streaming(struct siano_device *device, int error)
     if (!siano_stream_state_fail(&device->state, error))
         return;
 
+    pthread_mutex_lock(&device->state.mutex);
+    counter_add(&device->transfer_error_events, 1U, &device->counters_saturated);
+    pthread_mutex_unlock(&device->state.mutex);
     fprintf(stderr, "USB streaming stopped: %s\n", libusb_error_name(error));
